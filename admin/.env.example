# Supabase connection for the admin app. Copy to `.env.local` and fill in.
# The admin shares ONE Supabase Postgres database with the Laravel customer app.

# Public (browser-safe) publishable / anon key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER-ONLY secret / service_role key — NEVER prefix with NEXT_PUBLIC.
# Only read inside route handlers (src/app/api/admin/**).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Storage buckets (create as public buckets in the Supabase dashboard).
SUPABASE_SERVICE_IMAGES_BUCKET=service-images
SUPABASE_ORDER_SCREENSHOTS_BUCKET=order-screenshots

# Base URL used in the sign-in link emailed to new members.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# SMTP for sending member invite emails (sign-in link + credentials).
# Use the SAME SMTP server/credentials you configured in Supabase Auth → SMTP.
# If these are unset, members are still created — the owner just shares the
# login details manually (shown with a Copy button after adding).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
# Optional: set to true for port 465 (implicit TLS). Defaults to true when port is 465.
SMTP_SECURE=false
# The From address shown on the email (defaults to SMTP_USER if omitted).
MAIL_FROM="Dreammy Admin <no-reply@yourdomain.com>"
